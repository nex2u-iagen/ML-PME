# .env - Variáveis de Ambiente do projeto_ml
# Estas variáveis substituem os valores hardcoded e podem ser definidas
# no docker-compose.yml ou no sistema operacional.

# JWT Secret Key - Chave para assinatura de tokens JWT
# Padrão: CHAVE_MESTRE_SUPER_SECRETA_PRODUCAO_MINIMO_32_BYTES_2026
# Recomendado: Gerar uma chave de 32+ bytes para produção
JWT_SECRET_KEY=CHAVE_MESTRE_SUPER_SECRETA_PRODUCAO_MINIMO_32_BYTES_2026

# API Default Password - Senha padrão para autenticação
# Padrão: senha_segura_mercado_2026
# Use esta variável para sobreescrever a senha padrão
API_SENHA_PADRAO=senha_segura_mercado_2026

# Flask/Streamlit
# Porta do servidor Streamlit
PORT_STREAMLIT=8501

# Porta da API FastAPI
PORT_API=8000

# Ambiente
# 'dev' para desenvolvimento, 'producao' para produção
ENVIRONMENT=dev